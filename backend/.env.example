# =============================================
# .env.example — Copy this file to .env
# and fill in your own values
# =============================================

# MongoDB connection string
# Option A: MongoDB Atlas (free cloud DB)
#   mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart-task-manager
# Option B: Local MongoDB
#   mongodb://localhost:27017/smart-task-manager
MONGO_URI=mongodb://localhost:27017/smart-task-manager
JWT_SECRET=
# Port for the backend server
PORT=5000
GEMINI_API_KEY=your gemini api key